@model IEnumerable<inmobiliaria_airbnb.Models.Reserva>

@{
    ViewData["title"] = "Reservas";
}

<h1>
	Inmuebles
	<div class="btn-group pull-right">
		<a class="btn btn-primary" asp-action="Create" title="Crear">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard-plus-fill" viewBox="0 0 16 16">
                <path d="M6.5 0A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0zm3 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5z"/>
                <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1A2.5 2.5 0 0 1 9.5 5h-3A2.5 2.5 0 0 1 4 2.5zm4.5 6V9H10a.5.5 0 0 1 0 1H8.5v1.5a.5.5 0 0 1-1 0V10H6a.5.5 0 0 1 0-1h1.5V7.5a.5.5 0 0 1 1 0"/>
            </svg>
        </a>
	</div>
</h1>
<table class="table table-striped">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.IdReserva)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Estado)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Monto)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.FechaDesde)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.FechaHasta)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.InmuebleId)
			</th>
            <th>
                @Html.DisplayNameFor(model => model.Inmueble.Duenio.Nombre)
            </th>
			<th>
                @Html.DisplayNameFor(model => model.Inmueble.Duenio.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InquilinoId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inquilino.Nombre)
            </th>
			<th>
                @Html.DisplayNameFor(model => model.Inquilino.Apellido)
            </th>
		</tr>
	</thead>
	<tbody id="tablaReservas">
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.IdReserva)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Estado)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Monto)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.FechaDesde)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.FechaHasta)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.InmuebleId)
				</td>
                <td>
                    @Html.DisplayFor(modelItem => item.Inmueble.Duenio.Nombre)
                </td>
				<td>
                    @Html.DisplayFor(modelItem => item.Inmueble.Duenio.Apellido)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InquilinoId)
                </td>
				<td>
                    @Html.DisplayFor(modelItem => item.Inquilino.Nombre)
                </td>
				<td>
                    @Html.DisplayFor(modelItem => item.Inquilino.Apellido)
                </td>
				<td>
					<div class="btn-group" role="group">
						<a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.IdReserva" title="Editar">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                            </svg>
						</a>
						<a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.IdReserva" title="Eliminar">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eraser-fill" viewBox="0 0 16 16">
                                <path d="M8.086 2.207a2 2 0 0 1 2.828 0l3.879 3.879a2 2 0 0 1 0 2.828l-5.5 5.5A2 2 0 0 1 7.879 15H5.12a2 2 0 0 1-1.414-.586l-2.5-2.5a2 2 0 0 1 0-2.828zm.66 11.34L3.453 8.254 1.914 9.793a1 1 0 0 0 0 1.414l2.5 2.5a1 1 0 0 0 .707.293H7.88a1 1 0 0 0 .707-.293z"/>
                            </svg>
						</a>
						<a class="btn btn-secondary" @* asp-action="PorPropietario" *@ asp-controller="Reservas" asp-route-id="@item.IdReserva" title="Mis Propiedades">
							<i class="fa-solid fa-building"></i>
						</a>
					</div>
				</td>
			</tr>
		}
	</tbody>
</table>
<div>
	<button type="button" data-controller="Reservas" data-action="Index" class="btn btn-primary" data-pagina="@ViewBag.pagina" onclick="cambiarPagina('atras', this)">
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
			<path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
		</svg>
	</button>
	<button type="button" data-controller="Reservas" data-action="Index" class="btn btn-primary" data-pagina="@ViewBag.pagina" onclick="cambiarPagina('adelante', this)">
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
			<path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
		</svg>
	</button>

	<div class="row">
		<div class="w-25 mt-3">
			<label for="fechaDesde">Reservas desde</label>
			<input type="date" id="fechaDesde" name="fechaDesde" min="2026-01-01" max="2026-12-31" class="form-control">
		</div>
		<div class="w-25 mt-3">
			<label for="fechaHasta">Reservas hasta</label>
			<input type="date" id="fechaHasta" name="fechaHasta" min="2026-01-01" max="2026-12-31" class="form-control" onchange="manejarEvento('filtrarReservas')">
		</div>
	</div>
	<div class="w-25 mt-3">
		<select class="form-select" onchange="manejarEvento('SinReservas', this.value)">
			<option value="2">2 dias sin reservas</option>
			<option value="7">7 dias sin reservas</option>
			<option value="30">30 dias sin reservas</option>
			<option value="60">60 dias sin reservas</option>
			<option value="90">90 dias sin reservas</option>
			<option value="120">120 dias sin reservas</option>
			<option value="150">150 dias sin reservas</option>
			<option value="180">180 dias sin reservas</option>
			<option value="210">210 dias sin reservas</option>
		</select>
</div>

<script>
