	async function manejarEvento(evento, dias = null) {
		try {
			var url;
			if (evento == "filtrarReservas") {
				var fechaDesde = document.querySelector('#fechaDesde').value;
				var fechaHasta = document.querySelector('#fechaHasta').value;
				url = `/Reservas/FiltrarReservas?fechaDesde=${fechaDesde}&fechaHasta=${fechaHasta}`;
			} else if (evento == "SinReservas"){
				const diasInt = parseInt(dias, 10);
				url = `/Reservas/SinReservas?dias=${diasInt}`;
			}
@* 			const url = `/Reservas/SinReservas?dias=${diasInt}`; *@
			const response = await fetch(url);
			const data = await response.json();

			const tbody = document.querySelector("#tablaReservas");
			tbody.innerHTML = "";

			data.forEach(reserva => {
				tbody.innerHTML += `
						<tr>
							<td>${reserva.idReserva}</td>
							<td>${reserva.estado}</td>
							<td>${reserva.monto}</td>
							<td>${reserva.fechaDesde}</td>
							<td>${reserva.fechaHasta}</td>
							<td>${reserva.inmuebleId}</td>
							<td>${reserva.inmueble.duenio.nombre}</td>
							<td>${reserva.inmueble.duenio.apellido}</td>
							<td>${reserva.inquilinoId}</td>
							<td>${reserva.inquilino.nombre}</td>
							<td>${reserva.inquilino.apellido}</td>
						</tr>
					`;
			});
		} catch (error) {
			console.error("Error:", error);
		}
	};
</script>