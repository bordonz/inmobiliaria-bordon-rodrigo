@model inmobiliaria_airbnb.Models.Pago

@{
	ViewData["Title"] = "Pago Auditoria";
}

<h1>
	Auditoria
</h1>
<table class="table table-striped">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.IdPago)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Concepto)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.FechaPago)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Monto)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Estado)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.ReservaId)
			</th>
            <th>
				@Html.DisplayNameFor(model => model.IdUsuarioCreador)
			</th>
            <th>
				@Html.DisplayNameFor(model => model.IdUsuarioAnulador)
			</th>
		</tr>
	</thead>
	<tbody>
			<tr>
				<td>
					@Html.DisplayFor(modelItem => modelItem.IdPago)
				</td>
				<td>
					@Html.DisplayFor(modelItem => modelItem.Concepto)
				</td>
				<td>
					@Html.DisplayFor(modelItem => modelItem.FechaPago)
				</td>
				<td>
					@Html.DisplayFor(modelItem => modelItem.Monto)
				</td>
				<td>
					@Html.DisplayFor(modelItem => modelItem.Estado)
				</td>
				<td>
					@Html.DisplayFor(modelItem => modelItem.ReservaId)
				</td>
                <td>
					@Html.DisplayFor(modelItem => modelItem.IdUsuarioCreador)
				</td>
                <td>
                    @(Model.IdUsuarioAnulador.HasValue ? Model.IdUsuarioAnulador.ToString() : "—")
                </td>
				<td>
					<div class="btn-group" role="group">
						<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdPago" title="Editar">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                            </svg>
						</a>
						<a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.IdPago" title="Eliminar">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eraser-fill" viewBox="0 0 16 16">
                                <path d="M8.086 2.207a2 2 0 0 1 2.828 0l3.879 3.879a2 2 0 0 1 0 2.828l-5.5 5.5A2 2 0 0 1 7.879 15H5.12a2 2 0 0 1-1.414-.586l-2.5-2.5a2 2 0 0 1 0-2.828zm.66 11.34L3.453 8.254 1.914 9.793a1 1 0 0 0 0 1.414l2.5 2.5a1 1 0 0 0 .707.293H7.88a1 1 0 0 0 .707-.293z"/>
                            </svg>
						</a>
					</div>
				</td>
			</tr>
	</tbody>
</table>