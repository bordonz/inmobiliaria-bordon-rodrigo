@model inmobiliaria_airbnb.Models.Pago;
@{
	ViewData["Title"] = "Editar Pago";
}

@* TODO: Controllar type:hidden desde el servidor. *@
<h4>Editar Pago</h4>
<hr />
<div class="row">
	<div class="col-md-4">
		<form asp-action="Edit">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" name="IdPropietario" value="@Model.IdPago" />
			<div class="form-group">
				<label asp-for="Concepto" class="control-label"></label>
				<input asp-for="Concepto" class="form-control" />
				<span asp-validation-for="Concepto" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="FechaPago" class="control-label"></label>
				<input disabled asp-for="FechaPago" class="form-control" />
				<span asp-validation-for="FechaPago" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Monto" class="control-label"></label>
				<input disabled asp-for="Monto" class="form-control" />
				<span asp-validation-for="Monto" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Estado" class="control-label"></label>
				<input disabled asp-for="Estado" class="form-control" />
				<span asp-validation-for="Estado" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="ReservaId" class="control-label"></label>
				<input disabled asp-for="ReservaId" class="form-control" />
				<span asp-validation-for="ReservaId" class="text-danger"></span>
			</div>
			<div class="form-group">
				<input type="submit" value="Guardar" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>
<hr />
<div>
	<a asp-action="Index">Volver al listado</a>
</div>
